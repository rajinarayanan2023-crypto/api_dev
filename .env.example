# Copy this file to .env and fill in real values. Never commit the real .env.

# --- App ---
APP_NAME="Petrol Bunk Manager API"
ENVIRONMENT=development
DEBUG=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Auto sign-out after this many minutes with no activity (4 hours) — enforced
# server-side on every /auth/refresh call, independent of the browser's own
# idle timer (ui/src/components/Layout.jsx).
IDLE_TIMEOUT_MINUTES=240

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Ga_Petrol_Bunk
# "disable" for local Postgres, "require" for managed hosts like Neon that
# mandate TLS.
POSTGRES_SSLMODE=disable

# --- CORS (comma-separated origins allowed to call this API) ---
# Browsers treat localhost and 127.0.0.1 as different origins even though
# they're the same machine — both are listed so the UI works either way.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Trusted hosts (comma-separated, for TrustedHostMiddleware) ---
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Rate limiting (slowapi syntax) ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute

# --- Login OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
# "dev" logs the OTP server-side instead of sending a real SMS — no SMS
# provider account exists yet. See app/core/sms.py to wire in a real one
# (e.g. Twilio, MSG91) once you have credentials, then set this to match.
SMS_PROVIDER=dev
# Set to false to temporarily skip the OTP step (password-only login) —
# e.g. while SMS_PROVIDER isn't wired to a real provider yet.
OTP_ENABLED=true
