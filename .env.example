# Copy this file to .env and fill in real values. Never commit the real .env.

# --- App ---
APP_NAME="Petrol Bunk Manager API"
ENVIRONMENT=development
DEBUG=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Auto sign-out after this many minutes with no activity (4 hours) — enforced
# server-side on every /auth/refresh call, independent of the browser's own
# idle timer (ui/src/components/Layout.jsx).
IDLE_TIMEOUT_MINUTES=240

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=Ga_Petrol_Bunk
# "disable" for local Postgres, "require" for managed hosts like Neon that
# mandate TLS.
POSTGRES_SSLMODE=disable

# --- CORS (comma-separated origins allowed to call this API) ---
# Browsers treat localhost and 127.0.0.1 as different origins even though
# they're the same machine — both are listed so the UI works either way.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Trusted hosts (comma-separated, for TrustedHostMiddleware) ---
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Rate limiting (slowapi syntax) ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute

# --- Login OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
# SMS (Fast2SMS) has been removed entirely — Offers is WhatsApp-only now,
# and login OTP goes by email (app/core/email.py). "meta" sends real
# WhatsApp messages via MetaWhatsAppProvider (+ META_WHATSAPP_* below);
# "dev" just logs. This flag is a leftover shared name from when it also
# covered SMS; see app/core/sms.py/get_whatsapp_provider.
SMS_PROVIDER=dev
# Set to false to temporarily skip the OTP step (password-only login).
OTP_ENABLED=true

# --- WhatsApp (Meta Cloud API) ---
# Only required when SMS_PROVIDER=meta above; the app boots fine with these
# unset otherwise. From Meta Business Settings > System Users (or a temp
# user token while testing) — use a permanent System User token for real
# production use, not a 24hr temporary one. PHONE_NUMBER_ID is the sending
# number's id (WhatsApp > API Setup in Meta's dashboard). BUSINESS_ACCOUNT_ID
# isn't needed to send messages — kept for completeness/future use only.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any random string you generate (e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(24))"`) — paste the SAME value into Meta's
# dashboard (App > WhatsApp > Configuration > Webhook > Verify token) when
# subscribing app/controllers/whatsapp_webhook_controller.py's URL. Proves
# the one-time GET verification handshake really came from that setup step.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- File uploads (Cloudflare R2) ---
# Bill/document uploads (Fuel Entry bills, Credit Customer bills) go straight
# to this bucket via a presigned URL — see app/core/s3.py, which talks to R2
# through its S3-compatible API. These are R2's own Access Key ID / Secret
# Access Key from the Cloudflare dashboard (R2 > Manage API Tokens), NOT AWS
# IAM credentials. Leave unset and the app still starts fine; only the
# upload endpoints themselves will error until these are filled in. Bucket
# must be private (no public access) — every access is a short-lived
# presigned URL, generated on demand, never stored.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Email ---
# "smtp" (Gmail, below) is the default; "resend" sends via Resend's HTTP API
# instead (app/core/email.py's get_email_sender) — one flag, both
# implementations always present. Used for the login OTP email and the
# Audit report email.
EMAIL_PROVIDER=smtp

# --- Email (SMTP) ---
# Only required when EMAIL_PROVIDER=smtp above; the app boots fine with
# these unset otherwise, only failing when a send is actually attempted.
# SMTP_APP_PASSWORD is a Gmail App Password (myaccount.google.com/apppasswords),
# NOT the account's real login password — Gmail rejects SMTP auth with the
# real password once 2FA is on, which it must be to issue an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=GM Fuel Station Audit

# --- Email (Resend) ---
# Only required when EMAIL_PROVIDER=resend above. RESEND_API_KEY is from
# resend.com/api-keys. RESEND_FROM_EMAIL must be on a domain verified in
# the Resend dashboard (resend.com/domains) — an unverified sender domain
# is rejected by their API at send time, not at startup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
